# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit your key.

# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: override the default model used by the chat assistant.
GEMINI_MODEL=gemini-2.5-flash

# Slack Incoming Webhook — receives a notification when someone visits the site.
# Create one at https://api.slack.com/apps → your app → Incoming Webhooks.
# Leave unset locally to keep dev quiet; set it in Vercel for production only.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxxxxxx

# Optional: salt for the in-memory rate-limit hash. Any random string.
VISIT_HASH_SALT=change_me
